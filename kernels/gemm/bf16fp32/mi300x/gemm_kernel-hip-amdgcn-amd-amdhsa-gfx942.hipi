template<size_t I>
struct tuple_equal_to
{
    template<class T, class U>
    __attribute__((host)) __attribute__((device)) inline
    bool operator()(const T& lhs, const U& rhs) const
    {
        return tuple_equal_to<I-1>()(lhs, rhs) && get<I-1>(lhs) == get<I-1>(rhs);
    }
};

