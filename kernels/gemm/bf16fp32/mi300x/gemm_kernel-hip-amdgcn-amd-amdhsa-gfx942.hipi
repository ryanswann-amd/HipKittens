                            dst.tiles[i][j].data[k].x = val;
                        }
                        if ((MASKS[k * 2 + 1] >> lane) & 1) {
                            dst.tiles[i][j].data[k].y = src.tiles[i][j].data[k].y;
                        }
                        else {
                            dst.tiles[i][j].data[k].y = val;
                        }
                    }
                } else {
                    static_assert(false, "Unsupported shape");
                }
            }
        }
    }
}
