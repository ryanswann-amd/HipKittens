        stack,
        std::make_index_sequence<sizeof...(OutputTypes)>());
  }
  static void copy(const std::tuple<OutputTypes...>& output, Stack* stack) {
    copy_(output, stack, std::make_index_sequence<sizeof...(OutputTypes)>());
