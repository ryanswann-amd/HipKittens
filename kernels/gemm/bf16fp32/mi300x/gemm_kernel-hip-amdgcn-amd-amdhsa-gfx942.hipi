namespace c10 {
namespace detail {

template <typename T>
struct LoadImpl {
  __attribute__((host)) __attribute__((device)) static T apply(const void* src) {
    return *reinterpret_cast<const T*>(src);
  }
};

template <>
struct LoadImpl<bool> {
  __attribute__((host)) __attribute__((device)) static bool apply(const void* src) {
    static_assert(sizeof(bool) == sizeof(char));



    return *reinterpret_cast<const unsigned char*>(src);
  }
};

}

template <typename T>
__attribute__((host)) __attribute__((device)) constexpr T load(const void* src) {
  return c10::detail::LoadImpl<T>::apply(src);
}

template <typename scalar_t>
__attribute__((host)) __attribute__((device)) constexpr scalar_t load(const scalar_t* src) {
  return c10::detail::LoadImpl<scalar_t>::apply(src);
}

}
