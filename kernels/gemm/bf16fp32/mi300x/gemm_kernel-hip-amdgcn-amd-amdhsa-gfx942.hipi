class ReadableFunctionSignature {
public:
    using sig_type = decltype(detail::const_name("(") + cast_in::arg_names + detail::const_name(") -> ") + cast_out::name);

private:




    static constexpr sig_type sig() { return detail::const_name("(") + cast_in::arg_names + detail::const_name(") -> ") + cast_out::name; }

public:
    static constexpr sig_type kSig = sig();




