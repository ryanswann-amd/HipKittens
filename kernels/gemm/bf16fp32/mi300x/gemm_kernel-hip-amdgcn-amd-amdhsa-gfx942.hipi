    if (!(!t.is_nested_tensor())) { throw ::c10::NotImplementedError( {__func__, "/opt/venv/lib/python3.12/site-packages/torch/include/torch/csrc/dynamo/compiled_autograd.h", static_cast<uint32_t>(577)}, (::c10::detail::torchCheckMsgImpl( "Expected " "!t.is_nested_tensor()" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "NestedTensor support not implemented. "))); };

