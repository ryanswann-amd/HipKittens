template <
    class ArrayRefCls,
    typename T,
    size_t N,
    template <typename U> class PtrTraits = DefaultPtrTraits,
    typename index_t = int64_t>
class TensorAccessorBase {
 public:
  typedef typename PtrTraits<T>::PtrType PtrType;

  __attribute__((host)) __attribute__((device)) TensorAccessorBase(
      PtrType data_,
      const index_t* sizes_,
      const index_t* strides_)
      : data_(data_), sizes_(sizes_), strides_(strides_) {}
  __attribute__((host)) ArrayRefCls sizes() const {
    return ArrayRefCls(sizes_, N);
  }
  __attribute__((host)) ArrayRefCls strides() const {
    return ArrayRefCls(strides_, N);
  }
  __attribute__((host)) __attribute__((device)) index_t stride(index_t i) const {
    return strides_[i];
  }
  __attribute__((host)) __attribute__((device)) index_t size(index_t i) const {
    return sizes_[i];
  }
  __attribute__((host)) __attribute__((device)) PtrType data() {
    return data_;
  }
  __attribute__((host)) __attribute__((device)) const PtrType data() const {
    return data_;
  }

 protected:
  PtrType data_;
  const index_t* sizes_;
  const index_t* strides_;
};





template <
    class ArrayRefCls,
    typename T,
    size_t N,
    template <typename U> class PtrTraits = DefaultPtrTraits,
    typename index_t = int64_t>
class TensorAccessor
    : public TensorAccessorBase<ArrayRefCls, T, N, PtrTraits, index_t> {
 public:
  typedef typename PtrTraits<T>::PtrType PtrType;

  __attribute__((host)) __attribute__((device)) TensorAccessor(
      PtrType data_,
      const index_t* sizes_,
      const index_t* strides_)
      : TensorAccessorBase<ArrayRefCls, T, N, PtrTraits, index_t>(
            data_,
            sizes_,
            strides_) {}

  __attribute__((host)) __attribute__((device)) TensorAccessor<ArrayRefCls, T, N - 1, PtrTraits, index_t>
  operator[](index_t i) {
    return TensorAccessor<ArrayRefCls, T, N - 1, PtrTraits, index_t>(
        this->data_ + this->strides_[0] * i,
        this->sizes_ + 1,
        this->strides_ + 1);
  }

  __attribute__((host)) __attribute__((device)) const TensorAccessor<
      ArrayRefCls,
      T,
      N - 1,
      PtrTraits,
      index_t>
  operator[](index_t i) const {
    return TensorAccessor<ArrayRefCls, T, N - 1, PtrTraits, index_t>(
        this->data_ + this->strides_[0] * i,
        this->sizes_ + 1,
        this->strides_ + 1);
  }
};

template <
    class ArrayRefCls,
    typename T,
    template <typename U> class PtrTraits,
    typename index_t>
class TensorAccessor<ArrayRefCls, T, 1, PtrTraits, index_t>
    : public TensorAccessorBase<ArrayRefCls, T, 1, PtrTraits, index_t> {
 public:
  typedef typename PtrTraits<T>::PtrType PtrType;

  __attribute__((host)) __attribute__((device)) TensorAccessor(
      PtrType data_,
      const index_t* sizes_,
      const index_t* strides_)
      : TensorAccessorBase<ArrayRefCls, T, 1, PtrTraits, index_t>(
            data_,
            sizes_,
            strides_) {}
  __attribute__((host)) __attribute__((device)) T& operator[](index_t i) {

    return this->data_[this->strides_[0] * i];
  }
  __attribute__((host)) __attribute__((device)) const T& operator[](index_t i) const {
    return this->data_[this->strides_[0] * i];
  }
};
