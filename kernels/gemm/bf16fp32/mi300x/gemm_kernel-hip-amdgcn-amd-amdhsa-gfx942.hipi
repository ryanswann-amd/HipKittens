    if (!(false)) { ::c10::detail::torchCheckFail( __func__, "/opt/venv/lib/python3.12/site-packages/torch/include/ATen/core/Dict_inl.h", static_cast<uint32_t>(57), (::c10::detail::torchCheckMsgImpl( "Expected " "false" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "Can't hash IValues with tag '", ivalue.tagKind(), "'"))); };
