                                       const std::nothrow_t &) {
  return ::operator new(size);
}

__attribute__((device)) inline void operator delete(void* ptr) noexcept {
  if (ptr) {
    ::free(ptr);
  }
}
__attribute__((device)) inline void operator delete(void *ptr,
                                       const std::nothrow_t &) noexcept {
  ::operator delete(ptr);
