  return ::malloc(size);
}
__attribute__((device)) inline void *operator new(long unsigned int size,
                                     const std::nothrow_t &) noexcept {
  return ::operator new(size);
}

__attribute__((device)) inline void *operator new[](long unsigned int size) {
  return ::operator new(size);
}
