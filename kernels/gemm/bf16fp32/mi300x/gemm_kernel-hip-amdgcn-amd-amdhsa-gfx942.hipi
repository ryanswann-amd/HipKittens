struct check_wave_size<::rocprim::arch::wavefront::target::dynamic>
{
    template<typename P>
    inline __attribute__((host)) __attribute__((device))
    void operator()(P predicate) const
    {


        (static_cast <bool> (predicate(::rocprim::arch::wavefront::size())) ? void (0) : __assert_fail ("predicate(::rocprim::arch::wavefront::size())", __builtin_FILE (), __builtin_LINE (), __extension__ __PRETTY_FUNCTION__));



        (void)predicate;
    }
};

}

