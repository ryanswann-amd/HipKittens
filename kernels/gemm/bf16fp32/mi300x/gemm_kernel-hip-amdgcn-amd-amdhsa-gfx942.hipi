        (std::is_same_v<typename D::T, half> && std::is_same_v<typename A::T, half> &&
            std::is_same_v<typename B::T, half>)
    );



    using range_type_A = ducks::art::get_nth_range_t<typename A::register_ranges, N * A::width + K>;
