template <>
  struct hash<c10::AliasInfo> {
    size_t operator()(const c10::AliasInfo& aliasInfo) const {
      auto hash = std::hash<bool>()(aliasInfo.isWrite());




      size_t before_set_hash_seed = 0;
      for (auto &e: aliasInfo.beforeSets()) {
