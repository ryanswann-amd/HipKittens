inline object get_module_name_if_available(handle scope) {
    if (scope) {
        if (hasattr(scope, "__module__")) {
            return scope.attr("__module__");
        }
        if (hasattr(scope, "__name__")) {
            return scope.attr("__name__");
        }
    }
    return object();
}

