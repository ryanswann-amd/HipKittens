namespace detail {
inline Tensor gumbel_softmax(
    const Tensor& logits,
    double tau,
    bool hard,
    int dim) {
  auto gumbels =
      -torch::empty_like(logits).exponential_().log();
  gumbels = (logits + gumbels) / tau;
  auto y_soft = gumbels.softmax(dim);

  torch::Tensor ret;
  if (hard) {

    auto index = std::get<1>(y_soft.max(dim, true));
    auto y_hard = torch::zeros_like(logits).scatter_(dim, index, 1.0);
    ret = y_hard - y_soft.detach() + y_soft;
  } else {
    ret = y_soft;
  }
  return ret;
}
}
