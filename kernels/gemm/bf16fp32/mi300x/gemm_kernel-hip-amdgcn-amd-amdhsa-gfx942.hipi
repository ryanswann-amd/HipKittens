  SizeInput::DynType default_dyn_type;

  std::vector<uint32_t> size_input_origins;
  std::unordered_map<const SavedVariable*, std::pair<size_t, size_t>>
      sv_to_hooks;

  std::unordered_map<const Node*, std::pair<size_t, std::optional<size_t>>>
      pynode_objs;
